<?xml version="1.0" encoding="utf-8"?>
<!--
  4×1 «Таймлайн Суток»: статус, таймер и шкала 00…24.

  minResizeHeight=60dp — не «запас», а захист від обрізання: після збільшення шрифту пігулки
  до 10sp вмісту потрібно ≈64dp, і при меншій висоті лаунчер ріже нижній рядок навпіл.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_desc_timeline"
    android:initialLayout="@layout/svitlo_widget_timeline"
    android:maxResizeHeight="420dp"
    android:maxResizeWidth="520dp"
    android:minHeight="60dp"
    android:minResizeHeight="60dp"
    android:minResizeWidth="180dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/svitlo_widget_timeline"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
