<?xml version="1.0" encoding="utf-8"?>
<!--
  Разделитель плиток в «Командному Центрі».

  Почему отдельный drawable, а не `<View android:background="#2A2A2E">`: RemoteViews
  надувает только классы с аннотацией @RemoteView, и `android.view.View` к ним не
  относится — на HyperOS такой макет отвечает «Не вдається завантажити віджет».
  Здесь разделитель — ImageView с этим drawable в `android:src`.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#2A2A2E" />
</shape>
