<?xml version="1.0" encoding="utf-8"?>
<!--
  Фон 4×1 / 4×2 / 2×2: обсидиановая карточка — вертикальный градиент #18181B→#0C0C0E,
  скругление 22dp и тонкая обводка 1dp #2A2A2E, как поверхности приложения в тёмной теме.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#18181B"
        android:endColor="#0C0C0E" />
    <stroke
        android:width="1dp"
        android:color="#2A2A2E" />
    <corners android:radius="22dp" />
</shape>
