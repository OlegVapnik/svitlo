# Operator response samples may contain account identifiers, names, addresses, and session tokens
/1/
/operator-samples/
/sample-responses/
# Working notes / drafts (not part of the product)
ALL_IN_ONE.md
# Contract / service documents: personal data (names, emails, requisites) and NDA terms — never commit
*.docx
*.doc
*.odt

# Android-обёртка (Capacitor): нативный проект генерируется `npx cap add android`,
# build-каталоги и артефакты сборки не коммитим.
/apps/web/android/app/build/
/apps/web/android/build/
/apps/web/android/capacitor-cordova-android-plugins/build/
/apps/web/android/.gradle/
/apps/web/android/local.properties
# Готовый APK — производный артефакт, пересобирается tools/build-android-apk.sh
/apps/web/android-apk/
# APK для OTA лежит рядом с сайтом в Pages; в git его не храним.
/apps/web/public/svitlo-latest.apk
# Ключ release-подписи и его пароль: личные секреты, не для git. Потеря ключа =
# невозможность обновить уже установленное приложение.
/apps/web/android/keystore.properties
/apps/web/android/app/keystore/
*.jks
*.p12
# Кэш gradle (общий для всех локальных сборок Android)
.cache/

# Cloudflare Worker: зависимости, локальные состояния wrangler и базы D1/SQLite
cf-worker/node_modules/
cf-worker/.wrangler/
.wrangler/
.pages/
.mf/
*.sqlite
*.db-journal

# Python
__pycache__/
*.pyc

# Статические паки адресов — генерируются tools/build-address-packs.py перед сборкой Pages.
/apps/web/public/data/address/
# Тихий OTA JS-бандла — выход tools/build-ota-bundle.sh (сжатые бандлы ~2 МБ + манифест).
/apps/web/public/ota/
# Настройки IDE: в них абсолютные пути и личные раскладки, продукту они не нужны.
.idea/

# Готовые APK — производный артефакт, пересобирается tools/build-android-apk.sh (и уезжает в R2).
/apps/mobile/android-apk/

