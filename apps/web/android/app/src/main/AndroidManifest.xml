<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Виджет рабочего стола: система шлёт APPWIDGET_UPDATE по изменению размера, а данные
             приходят из WebView через window.SvitloNative.syncState (SharedPreferences). -->
        <receiver
            android:name=".SvitloWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/svitlo_widget_info" />
        </receiver>

        <!-- Фоновое обновление виджета раз в 30 минут и кнопка «Оновити» на самой плашке.
             Будильник шлёт явный broadcast, поэтому exported=false: снаружи его не вызвать. -->
        <receiver
            android:name=".WidgetRefreshReceiver"
            android:exported="false" />

        <!-- Фоновые уведомления: будильники AlarmManager бьют в этот receiver, даже когда
             приложение выгружено из памяти. exported=false — снаружи его не вызвать. -->
        <receiver
            android:name=".OutageAlarmReceiver"
            android:exported="false" />

        <!-- После перезагрузки телефона AlarmManager пуст. Receiver читает последний снимок из
             SharedPreferences и заново ставит будильники + обновляет виджет. Системные broadcast'ы
             доставляются и при exported=false. -->
        <receiver
            android:name=".BootCompletedReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- OTA: после скачивания APK открываем системный установщик. exported=false —
             снаружи этот приёмник вызвать нельзя. -->
        <receiver
            android:name=".UpdateDownloadReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: без этого разрешения нативные уведомления не показываются. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Точные будильники за 15 минут до отключения. Если человек не дал разрешение,
         OutageAlarmReceiver откатывается на setAndAllowWhileIdle. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- После reboot нужно снова запланировать будильники; без этого разрешения система не
         доставит BOOT_COMPLETED. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- OTA: Android 8+ требует это разрешение, чтобы приложение могло открыть установщик APK.
         Система всё равно покажет человеку отдельное подтверждение. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
