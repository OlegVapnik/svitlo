<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет 4×2: состояние черги, крупный ответ «до которого часа» и 24-часовая полоса.
     Раньше нижняя половина была пустым чёрным квадратом, а часы без света подписывались
     «−5 год 30 хв» рядом со «Світло є» — минус читался как ошибка таймера. Теперь акцент
     стоит на ближайшем переключении, а полоса заполняет низ плашки полезной графикой.
     Только View, которые поддерживает RemoteViews (LinearLayout/TextView/ImageView):
     иначе AppWidgetManager молча нарисует пустую плашку на части прошивок. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_region"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_default_region"
            android:textColor="@color/svitlo_widget_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_queue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_badge_background"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="@string/widget_default_queue"
            android:textColor="@color/svitlo_widget_primary"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_refresh"
            android:padding="3dp"
            android:src="@drawable/ic_widget_refresh"
            android:tint="@color/svitlo_widget_muted" />
    </LinearLayout>

    <!-- Статус-пилл: цветная точка + текст. Крупная строка ниже отвечает на главный вопрос. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_unknown" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_default_status"
            android:textColor="@color/svitlo_widget_muted"
            android:textSize="13sp" />

        <!-- Без минуса и без «огромной дыры» справа: это суммарные часы за сутки, подпись
             говорит об этом прямо. -->
        <TextView
            android:id="@+id/widget_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/svitlo_widget_danger"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-black"
        android:maxLines="1"
        android:text="@string/widget_default_next"
        android:textColor="@color/svitlo_widget_text"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/widget_hero_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/svitlo_widget_muted"
        android:textSize="11sp" />

    <!-- 24-часовая полоса: зелёные часы со светом, красные окна отключений и белая риска
         «зараз». Рисуется Bitmap'ом в провайдере: RemoteViews не умеет ни Canvas, ни
         динамические View. -->
    <ImageView
        android:id="@+id/widget_graph"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <!-- Чипы окон вместо строки через запятую: прошлое приглушено, следующее — акцентное. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_chip_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_muted"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:textColor="@color/svitlo_widget_muted"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_chip_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_chip_accent"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:textColor="@color/svitlo_widget_text"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Итог суток и актуальность: «Без світла за добу: 5 год 30 хв» слева, время
         обновления справа. Без знака минус — это сумма, а не остаток. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_hours_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/svitlo_widget_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:textColor="@color/svitlo_widget_muted"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
