<?xml version="1.0" encoding="utf-8"?>
<!-- Компактная капсула 2×1: только код черги, цветная точка статуса и ближайшее переключение.
     Отдельный layout, а не скрытые View в большом: RemoteViews не умеет переставлять блоки, и
     спрятанные строки оставляли бы пустые отступы в маленькой плашке. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_unknown" />

        <TextView
            android:id="@+id/widget_queue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_background"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingStart="7dp"
            android:paddingTop="1dp"
            android:paddingEnd="7dp"
            android:paddingBottom="1dp"
            android:text="@string/widget_default_queue_short"
            android:textColor="@color/svitlo_widget_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:maxLines="1"
            android:text="@string/widget_default_status"
            android:textColor="@color/svitlo_widget_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_default_next"
        android:textColor="@color/svitlo_widget_muted"
        android:textSize="10sp" />
</LinearLayout>
