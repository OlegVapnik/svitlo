{
  "expo": {
    "name": "Svitlo",
    "slug": "svitlo",
    "version": "2.39.1",
    "orientation": "portrait",
    "scheme": "svitlo",
    "icon": "./assets/icon.png",
    "backgroundColor": "#09090b",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "ua.com.svitlo.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/ios-icon-dark.png",
        "tinted": "./assets/ios-icon-tinted.png"
      },
      "infoPlist": {
        "CFBundleDisplayName": "Svitlo",
        "CFBundleDevelopmentRegion": "uk",
        "CFBundleLocalizations": [
          "uk"
        ],
        "LSRequiresIPhoneOS": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Svitlo не збирає геодані. Дозвіл потрібен лише для швидкого пошуку вашої черги за адресою.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "ua.com.svitlo.app",
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 273
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/splash-icon.png",
          "imageWidth": 128,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#09090b",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "./plugins/withAndroidWidget",
      "./plugins/withSvitloNative",
      "expo-font",
      "expo-sharing",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
