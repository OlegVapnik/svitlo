<?xml version="1.0" encoding="utf-8"?>
<!--
  2×1: «статус одним взглядом». Только картинка и тап «открыть приложение»: на такой высоте
  ни обновлению, ни переключению очереди некуда встать так, чтобы зона совпала с рисунком.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/widget_open"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:contentDescription="@string/widget_label"
        android:focusable="true" />

    <ImageView
        android:id="@+id/widget_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />
</FrameLayout>
