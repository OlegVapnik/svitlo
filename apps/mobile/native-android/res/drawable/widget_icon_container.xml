<?xml version="1.0" encoding="utf-8"?>
<!--
  Контейнер иконки места в «Радарі Моїх Місць»: скруглённый квадрат #1C1C1F
  с той же обводкой, что у плиток, — иконка больше не «висит в воздухе».
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#1C1C1F" />
    <stroke
        android:width="1dp"
        android:color="#2A2A2E" />
    <corners android:radius="9dp" />
</shape>
